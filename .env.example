# Đường dẫn API Gateway (Client gửi qua prefix này)
VITE_API_URL=/api/v1

# Chế độ Mock dữ liệu:
# - 'true': Dùng Mock Data nội bộ (dành cho frontend dev độc lập)
# - 'false': Gọi Backend API Gateway thực tế (dành cho Tester & Live BE)
VITE_USE_MOCK=false

# Host API Gateway Backend thực tế (BE chạy cổng 8081)
VITE_GATEWAY_TARGET=http://localhost:8081
