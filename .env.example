# Đường dẫn API Gateway (Client gửi qua prefix này)
VITE_API_URL=/api/v1

# Chế độ Mock dữ liệu:
# - 'true': Dùng Mock Data nội bộ (dành cho frontend dev độc lập)
# - 'false': Gọi Backend API Gateway thực tế (dành cho Tester & Live BE)
VITE_USE_MOCK=false

# Host API Gateway Backend thực tế (BE chạy cổng 8081)
VITE_GATEWAY_TARGET=http://localhost:8081

# WebSocket URL cho Realtime Notifications / Events (Tùy chọn: mặc định tự suy ra từ VITE_GATEWAY_TARGET)
# VITE_WS_URL=ws://localhost:8081/ws/notifications

# Micro-Frontend Remote URLs (Tùy chọn: dùng khi deploy Docker / Staging / Production)
# VITE_REMOTE_BUYER_URL=http://localhost:5174/assets/remoteEntry.js
# VITE_REMOTE_SELLER_URL=http://localhost:5175/assets/remoteEntry.js
# VITE_REMOTE_ADMIN_URL=http://localhost:5176/assets/remoteEntry.js

# Google OAuth 2.0 Web Client ID (Public Client ID for Google Identity Services)
VITE_GOOGLE_CLIENT_ID=568881563258-nfq5v7idh8057i9fmsea0i2i8qfem0q3.apps.googleusercontent.com

