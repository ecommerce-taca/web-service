{
  "name": "taca_ecommerce_monorepo",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "build:remotes": "npm run build -w @taca/buyer -w @taca/seller -w @taca/admin",
    "serve:remotes": "concurrently \"npm run preview -w @taca/buyer\" \"npm run preview -w @taca/seller\" \"npm run preview -w @taca/admin\"",
    "dev:shell": "npm run dev -w @taca/shell",
    "dev": "concurrently \"npm run build:remotes && npm run serve:remotes\" \"npm run dev:shell\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "puppeteer": "^25.11.0"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --fix"
  }
}
